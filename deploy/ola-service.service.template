[Unit]
Description=OLA message service
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
Environment=PYTHONUNBUFFERED=1
Environment=OLA_TZ=Europe/Kyiv
ExecStart=__DIR__/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port __PORT__
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
